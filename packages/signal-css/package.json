    "./layout.css": "./src/layout.css",
    "./media.css": "./src/media.css",
    "./forms.css": "./src/forms.css",
    "./navigation.css": "./src/navigation.css",
    "./data.css": "./src/data.css",
    "./overlays.css": "./src/overlays.css",
    "./components.css": "./src/components.css"
